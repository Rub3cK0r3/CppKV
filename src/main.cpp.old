// Orquestador del MVP
//
// Primero versión fácil para hacerla después más avanzada
// (httplib + unordered_map + mutex)
//
#include "include/refs/httplib.h"
#include "include/refs/unordered_map.h"
#include "include/refs/std_mutex.h"
#include "nlohmann/json.hpp" // nlohmann/json installed via apt

void exec_simple_mvp()
{
    httplib::Server srvr; // Server implementation of httplib
    std::unordered_map<std::string, std::string> kv_store; // Hash Map (unordered_map) of custom types
    std::mutex mtx; // Cerrojo para que haya exclusión de varios hilos en el mismo objeto, archivo, etc (exclusión mutua)

    // Guardar clave-valor: POST /set
    srvr.Post("/set", [&](const httplib::Request& req, httplib::Response& res) {
        std::lock_guard<std::mutex> lock(mtx);

        try {
            auto body = nlohmann::json::parse(req.body);

            std::string key = body.at("key").get<std::string>();
            std::string val = body.at("value").get<std::string>();

            kv_store[key] = val;

            res.set_content(
                R"({"mensaje":"Guardado correctamente"})",
                "application/json"
            );
        } catch (const std::exception&) {
            res.status = 400;
            res.set_content(
                R"({"error":"JSON inválido o faltan campos"})",
                "application/json"
            );
        }
    });

    // Obtener valor: /get?key=nombre
    srvr.Get("/get", [&](const httplib::Request& req, httplib::Response& res){
        std::lock_guard<std::mutex> lock(mtx);// SOLO UNO A LA VEZ
        
        std::string key = req.get_param_value("key");
        if (kv_store.count(key)){
            res.set_content(kv_store[key], "text/plain");
        } else {
            res.status = 404;
            res.set_content("No encontrado", "text/plain");
        }
    });
}

int main()
{
    exec_simple_mvp();
    return 0;
}
